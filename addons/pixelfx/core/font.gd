static var FONTS := {
	"mini": {"h": 5, "space": 2, "gap": 1, "glyphs": _build(MINI, 5)},
	"big": {"h": 7, "space": 3, "gap": 1, "glyphs": _build(BIG, 7)},
}


static func _build(table: Dictionary, h: int) -> Dictionary:
	var out := {}
	for ch in table:
		var rows: PackedStringArray = String(table[ch]).split("|")
		var bits := []
		for r in rows:
			var row := []
			for i in r.length():
				row.append(r[i] == "#")
			bits.append(row)
		assert(rows.size() == h, "glyph %s has %d rows, expected %d" % [ch, rows.size(), h])
		out[ch] = {"w": rows[0].length(), "rows": bits}
	return out


static func _glyph(F: Dictionary, ch: String) -> Variant:
	var g: Variant = F.glyphs.get(ch)
	if g == null:
		g = F.glyphs.get(ch.to_upper())
	return g


## Width in font pixels of a string (before scaling).
static func textWidth(s: Variant, font: String = "mini") -> int:
	var F: Dictionary = FONTS[font]
	var w := 0
	var text := str(s)
	for i in text.length():
		var g: Variant = _glyph(F, text[i])
		w += (g.w if g != null else F.space) + F.gap
	return maxi(0, w - F.gap)


## Calls plot.call(x, y) for every inked font pixel of s, with the top-left of the text at (0, 0).
static func rasterText(s: Variant, font: String, plot: Callable) -> void:
	var F: Dictionary = FONTS[font]
	var x := 0
	var text := str(s)
	for i in text.length():
		var g: Variant = _glyph(F, text[i])
		if g == null:
			x += F.space + F.gap
			continue
		for r in F.h:
			var row: Array = g.rows[r]
			for c in g.w:
				if row[c]:
					plot.call(x + c, r)
		x += g.w + F.gap
