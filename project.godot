[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="bullet_wall"
2d_physics/layer_3="bullet"
2d_physics/layer_4="enemy"
2d_physics/layer_5="floor"
2d_physics/layer_6="item"
