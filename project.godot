; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Enter The Nyangeon"
run/main_scene="res://scenes/main/title_screen.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://ui/game_icon.png"

[autoload]

PlayerData="*res://script/PlayerData.gd"
GameEvents="*res://script/GameEvents.gd"
SoundManager="*res://scenes/manager/sound_manager.tscn"
Transition="*res://ui/transition.tscn"
Game="*res://script/Game.gd"
FloatingPool="*res://script/FloatingPool.gd"
PoolManager="*res://scenes/manager/PoolManager.gd"
SupportData="*res://script/support_data.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://sprites/crosshair/mouse.png"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/default_font_antialiasing=0
theme/custom="res://fonts/theme.tres"

