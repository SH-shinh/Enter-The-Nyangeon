[gd_resource type="Resource" script_class="DanmakuBarrage" load_steps=9 format=3]

[ext_resource type="Script" path="res://resources/danmaku/danmaku_barrage.gd" id="1_script"]
[ext_resource type="Script" path="res://resources/danmaku/danmaku_cue.gd" id="2_cue"]
[ext_resource type="Resource" path="res://resources/danmaku/patterns/curtain_parallel.tres" id="3_curtain"]
[ext_resource type="Resource" path="res://resources/danmaku/patterns/fan9_wide.tres" id="4_fan9"]
[ext_resource type="Resource" path="res://resources/danmaku/patterns/ring16.tres" id="5_ring16"]

[sub_resource type="Resource" id="Resource_cue_curtain_1"]
script = ExtResource("2_cue")
pattern = ExtResource("3_curtain")
time = 0.5
repeat = 3
repeat_interval = 1.1

[sub_resource type="Resource" id="Resource_cue_curtain_2"]
script = ExtResource("2_cue")
pattern = ExtResource("4_fan9")
time = 2.4

[sub_resource type="Resource" id="Resource_cue_curtain_3"]
script = ExtResource("2_cue")
pattern = ExtResource("5_ring16")
time = 3.6

[resource]
script = ExtResource("1_script")
id = "p2_curtain"
display_name = "阶段2：弹幕墙 + 扇 + 环"
notes = "弹幕墙负责压缩场地，扇/环负责逼进缝隙；墙之间留 1.1 秒换气。"
cues = [SubResource("Resource_cue_curtain_1"), SubResource("Resource_cue_curtain_2"), SubResource("Resource_cue_curtain_3")]
duration = 4.8
cooldown = 1.2
phases = 2
