[gd_resource type="Resource" script_class="DanmakuBarrage" load_steps=9 format=3]

[ext_resource type="Script" path="res://resources/danmaku/danmaku_barrage.gd" id="1_script"]
[ext_resource type="Script" path="res://resources/danmaku/danmaku_cue.gd" id="2_cue"]
[ext_resource type="Resource" path="res://resources/danmaku/patterns/aimed_single.tres" id="3_aimed"]
[ext_resource type="Resource" path="res://resources/danmaku/patterns/fan3.tres" id="4_fan3"]
[ext_resource type="Resource" path="res://resources/danmaku/patterns/fan9_wide.tres" id="5_fan9"]

[sub_resource type="Resource" id="Resource_cue_open_1"]
script = ExtResource("2_cue")
pattern = ExtResource("3_aimed")
time = 0.0

[sub_resource type="Resource" id="Resource_cue_open_2"]
script = ExtResource("2_cue")
pattern = ExtResource("4_fan3")
time = 0.9
repeat = 3
repeat_interval = 0.55

[sub_resource type="Resource" id="Resource_cue_open_3"]
script = ExtResource("2_cue")
pattern = ExtResource("5_fan9")
time = 3.2

[resource]
script = ExtResource("1_script")
id = "p1_open"
display_name = "起手：瞄准 + 三连扇 + 宽扇"
notes = "先单发建立朝向，再三连扇给走位节奏，最后宽扇收尾。"
cues = [SubResource("Resource_cue_open_1"), SubResource("Resource_cue_open_2"), SubResource("Resource_cue_open_3")]
duration = 4.2
cooldown = 1.0
phases = 1
