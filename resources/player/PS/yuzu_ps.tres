t_level = Array[String](["子弹造成范围爆炸伤害，连续造成命中可叠加提高2%子弹伤害，中断时清空。", "+25%暴击伤害，每提升1%暴击伤害额外提升1%射速。", "+25%暴击伤害，换弹后3秒内提升50%暴击伤害。", "+25%暴击伤害，连击还可提高5%暴击伤害。"])
